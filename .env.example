# ─── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=                  # e.g. https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=           # e.g. gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=      # e.g. text-embedding-3-small

# ─── Azure PostgreSQL ─────────────────────────────────────────────────────────
AZURE_PG_HOST=                          # e.g. pg-snie-dev-xxxxx.postgres.database.azure.com
AZURE_PG_DATABASE=                      # e.g. pgdb-snie-dev
AZURE_PG_USER=                          # e.g. sniadmin@pg-snie-dev-xxxxx.postgres.database.azure.com
AZURE_PG_PASSWORD=
AZURE_PG_PORT=5432

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
# Local mode: leave CHROMA_HOST blank to use PersistentClient on CHROMA_PATH
# Cloud/remote mode: set CHROMA_HOST + CHROMA_PORT
CHROMA_PATH=./chroma_db                 # local persistent storage directory
CHROMA_HOST=                            # leave blank for local dev
CHROMA_PORT=8000
CHROMA_COLLECTION=term_sheets           # collection name for note chunks

# ─── App config ───────────────────────────────────────────────────────────────
API_PORT=3001
ALLOWED_ORIGINS=http://localhost:3000   # comma-separated list for CORS
LOG_LEVEL=INFO
